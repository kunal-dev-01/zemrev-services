# ============================================================================
# FILE: services/pypdf-service/.env.production
# PURPOSE: Production environment
# ============================================================================

# Queue Config (read by zemrev-queue package)
REDIS_URL=redis://redis-queue:6379
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
QUEUE_NAME=zemrev_pypdf_jobs
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT=900
QUEUE_RESULT_TTL=600

# Service Config
WORKERS=2
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8003
UPLOAD_DIR=/tmp/zemrev_pypdf_uploads
QUEUE_MAX_WORKERS=2

# Tool-Specific Limits
MAX_FILE_SIZE=157286400
MAX_PAGES=400
TOOL_TIMEOUT=300