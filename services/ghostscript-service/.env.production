# ============================================================================
# FILE: services/ghostscript-service/.env.production
# PURPOSE: Production environment
# ============================================================================

# Queue Config 
REDIS_URL=redis://redis-queue:6379
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
QUEUE_NAME=zemrev_ghostscript_jobs
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT=1200
QUEUE_RESULT_TTL=600

# Service Config
WORKERS=2
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8001
UPLOAD_DIR=/tmp/zemrev_ghostscript_uploads
QUEUE_MAX_WORKERS=2

# Tool-Specific Limits

MAX_FILE_SIZE = 83886080      # 80MB
MAX_PAGES = 250