# ============================================================================
# FILE: services/pymupdf-service/.env.production
# PURPOSE: Production environment
# ============================================================================

# Queue Config 
REDIS_URL=redis://redis-queue:6379
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
QUEUE_NAME=zemrev_pymupdf_jobs
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT=900
QUEUE_RESULT_TTL=600

# Service Config
WORKERS=2
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8002
ALLOWED_ORIGINS=https://www.zemrev.com,https://zemrev.com,https://api.zemrev.com,http://api.zemrev.com/
UPLOAD_DIR=/tmp/zemrev_pymupdf_uploads
QUEUE_MAX_WORKERS=2

# Tool-Specific Limits
MAX_FILE_SIZE=62914560
MAX_PAGES=300
TOOL_TIMEOUT=300